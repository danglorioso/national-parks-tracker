{
  "expo": {
    "name": "ParkQuest",
    "slug": "parkquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "parkquest",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parkquest.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.parkquest.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        { "photosPermission": "ParkQuest needs access to your photos to share your adventures." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "ParkQuest uses your location to show nearby parks." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
